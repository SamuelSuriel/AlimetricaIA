# Variables de entorno de Alimétrica IA
# Copia este archivo como ".env" y completa los valores reales.
# (El archivo .env NO se sube al repositorio por seguridad.)

# --- Supabase (Base de datos y autenticación) ---
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_de_supabase

# --- Groq (Análisis nutricional con IA - Llama) ---
# Obtén una clave gratuita en: https://console.groq.com/keys
# Si no la configuras, la app usa un análisis local de respaldo.
EXPO_PUBLIC_GROQ_API_KEY=tu_api_key_de_groq
